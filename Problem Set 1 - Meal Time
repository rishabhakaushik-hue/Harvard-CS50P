def convert(time):
    (a,b) = time.split(":")
    x = float(a)
    y = float(b)
    decimal = x+y/60
    return decimal
def main():
    time = input("What time is it? ")
    decimal = convert(time)
    if 7.0 <= decimal <= 8.0:
        print("breakfast time")
    elif 12.0 <= decimal <= 13.0:
        print("lunch time")
    elif 18.0 <= decimal <= 19.0:
        print("dinner time")
if __name__ == "__main__":
    main()
